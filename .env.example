# Copy to `.env` (repo root, gitignored) for local overrides; every `make` target loads it, below the
# shell environment in precedence (README -> Configuration). KEY=value lines, value optionally in
# quotes; no spaces, `$` or `#` in values. Every variable read by api/app/config.py or interpolated
# by infra/docker-compose.yml is listed here; the values are the defaults the Makefile and compose
# already use, so an unedited copy changes nothing.

# Host ports compose publishes Postgres, Redis and the API on (bound to 127.0.0.1). API_PORT also sets
# the web's VITE_API_URL (http://localhost:API_PORT). The web itself is always on 5173 (WEB_ORIGIN).
DB_PORT=5432
REDIS_PORT=6379
API_PORT=8000

# API settings. The three URLs are commented out on purpose: the Makefile derives them from
# DB_PORT / REDIS_PORT. Uncomment one only to point it somewhere else; it then wins over the ports.
# DATABASE_URL=postgresql+psycopg://rent:rent@localhost:5432/rent
# TEST_DATABASE_URL=postgresql+psycopg://rent:rent@localhost:5432/rent_test
# REDIS_URL=redis://localhost:6379/0
WEB_ORIGIN=http://localhost:5173

# Auth (spec 0001a). SECRET_KEY keys the OTP HMAC: at least 32 characters; this dev value must never
# reach production. EMAIL_BACKEND=file writes each email as JSON into EMAIL_OUTBOX_DIR; smtp sends
# through SMTP_URL (smtp:// = STARTTLS on 587, smtps:// = TLS on 465), required only for smtp.
SECRET_KEY=dev-only-secret-change-me-0123456789abcdef
EMAIL_BACKEND=file
EMAIL_OUTBOX_DIR=./.outbox
EMAIL_FROM=noreply@localhost
# SMTP_URL=smtp://user:pass@smtp.example.com:587
COOKIE_SECURE=false

# Geocoding (spec 0003c), read by the worker only. GEOCODER=fake gives deterministic points with no
# network: the default for dev, CI and e2e. GEOCODER=nominatim calls NOMINATIM_URL (the public OSM
# instance: at most 1 request/s, results cached) and needs a real identifying NOMINATIM_USER_AGENT in
# production, without an email; production sets one such as `rent-app/1.0 (+https://<domain>)` in the
# host's secret env, not through this file (values here may not contain spaces).
GEOCODER=fake
# NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=rent-app-dev/0.0.1
