# Copy to `.env` (repo root, gitignored) for local overrides; every `make` target loads it, below the
# shell environment in precedence (README -> Configuration). KEY=value lines, value optionally in
# quotes; no spaces, `$` or `#` in values. Every variable read by api/app/config.py or interpolated
# by infra/docker-compose.yml is listed here; the values are the defaults the Makefile and compose
# already use, so an unedited copy changes nothing.

# Host ports compose publishes Postgres, Redis and the API on (bound to 127.0.0.1). API_PORT also sets
# the web's VITE_API_URL (http://localhost:API_PORT). WEB_PORT is the host port of the web (Vite); WEB_ORIGIN follows it.
DB_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=5173

# API settings. The three URLs are commented out on purpose: the Makefile derives them from
# DB_PORT / REDIS_PORT. Uncomment one only to point it somewhere else; it then wins over the ports.
# DATABASE_URL=postgresql+psycopg://rent:rent@localhost:5432/rent
# TEST_DATABASE_URL=postgresql+psycopg://rent:rent@localhost:5432/rent_test
# REDIS_URL=redis://localhost:6379/0
# Derived from WEB_PORT; uncomment only to override (CORS allows exactly this origin).
# WEB_ORIGIN=http://localhost:5173

# Auth (spec 0001a). SECRET_KEY keys the OTP HMAC: at least 32 characters; this dev value must never
# reach production. EMAIL_BACKEND=file writes each email as JSON into EMAIL_OUTBOX_DIR; smtp sends
# through SMTP_URL (smtp:// = STARTTLS on 587, smtps:// = TLS on 465), required only for smtp.
SECRET_KEY=dev-only-secret-change-me-0123456789abcdef
# Keys the hash of a blocked email (spec 0013c): at least 32 characters, never rotate it (the hashes
# cannot be re-keyed), and this dev value is refused when WEB_ORIGIN is https.
EMAIL_BLOCK_KEY=dev-only-email-block-key-0123456789abcdef
EMAIL_BACKEND=file
EMAIL_OUTBOX_DIR=./.outbox
EMAIL_FROM=noreply@localhost
# SMTP_URL=smtp://user:pass@smtp.example.com:587
COOKIE_SECURE=false
# Spec 0013b. `fly` only behind Fly's proxy (spec 0013a sets it in production): the client address is
# read from `Fly-Client-IP`; `none` uses the socket peer (dev, CI). Never set `fly` where clients can
# reach the API without passing Fly's proxy.
TRUST_PROXY=none

# Geocoding (spec 0003c), read by the worker only. GEOCODER=fake gives deterministic points with no
# network: the default for dev, CI and e2e. GEOCODER=nominatim calls NOMINATIM_URL (the public OSM
# instance: at most 1 request/s, results cached) and needs a real identifying NOMINATIM_USER_AGENT in
# production, without an email; production sets one such as `rent-app/1.0 (+https://<domain>)` in the
# host's secret env, not through this file (values here may not contain spaces).
GEOCODER=fake
# NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=rent-app-dev/0.0.1

# Web map (spec 0003d). The MapLibre style URL the browser loads; the default is the bundled style on
# public OpenStreetMap raster tiles. Switching to self-hosted Protomaps = pointing this at that style
# (plus MapLibre's RTL text plugin for its Hebrew labels; see specs/archive/0003d-map-web.md, Risks).
VITE_MAP_STYLE_URL=/map/osm-raster.json

# The contact address shown in the footer and the legal pages (spec 0013f). Production sets the real one
# in the web build; unset, the pages show contact@example.com.
VITE_CONTACT_EMAIL=contact@example.com

# Photos (spec 0010d). PHOTO_BACKEND=file stores the uploaded photos (two WebP sizes each) in PHOTO_DIR
# and the api serves them at /media: the default for dev, CI and e2e. PHOTO_BACKEND=r2 stores them in
# a Cloudflare R2 bucket; PHOTO_PUBLIC_BASE_URL is then the bucket's public https address. Production
# sets the four R2_* values in the host's secret env, never in this file.
PHOTO_BACKEND=file
PHOTO_DIR=./.media
PHOTO_PUBLIC_BASE_URL=http://localhost:8000/media
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Official rent figures (spec 0014a), read by the worker only. RENT_REFERENCE=off makes no request:
# the default for dev, CI and e2e. RENT_REFERENCE=nadlan imports nadlan.gov.il's public rent files
# once a month (and on `make rent-import`) from NADLAN_RENT_URL (https only, no trailing slash).
RENT_REFERENCE=off
# NADLAN_RENT_URL=https://data.nadlan.gov.il/api/pages

# CBS small-flat rent figures (spec 0014d), read by the worker only. CBS_RENT=off makes no request: the
# default for dev, CI and e2e. CBS_RENT=cbs imports Table 4.9 of the CBS Price Statistics Monthly from
# cbs.gov.il once a month (and on `make cbs-rent-import`; `make cbs-rent-history` for the older bulletins).
CBS_RENT=off

# Google sign-in (spec 0016b). GOOGLE_VERIFIER=fake accepts `fake:<sub>:<email>` credentials (what compose
# uses; refused on an https WEB_ORIGIN); the code default `off` (what a deployment that sets nothing gets)
# answers 503; `google` verifies real ID tokens and needs GOOGLE_CLIENT_ID. VITE_GOOGLE_CLIENT_ID (the same
# client id, not a secret) shows the button; both empty keep it hidden.
GOOGLE_VERIFIER=fake
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Sentry error reports (spec 0019a), EU region (de.sentry.io). All unset = off (dev, CI, e2e). Production
# values are in specs/0013a-production-deploy.md.
# The api and worker project's DSN; empty means no report is sent.
# SENTRY_DSN=
# The environment name on each report (production sets `production`).
# SENTRY_ENVIRONMENT=development
# The release on each report (production sets the git sha).
# SENTRY_RELEASE=
# Share of requests traced, 0 to 1; 0 = errors only (the decision, PRODUCT.md "Observability").
# SENTRY_TRACES_SAMPLE_RATE=0
# The web project's DSN, baked into the build; empty means the browser sends nothing.
# VITE_SENTRY_DSN=
# The environment name on the web's reports.
# VITE_SENTRY_ENVIRONMENT=development
# The web's release (the git sha, as SENTRY_RELEASE); also names the source-map upload.
# VITE_SENTRY_RELEASE=
# Build-time only: with a token, `make build-web` uploads hidden source maps to Sentry and deletes them
# from dist. Lives in your local env only, never in CI or the bundle.
# SENTRY_AUTH_TOKEN=
# The Sentry organisation and project slugs the source maps are uploaded to.
# SENTRY_ORG=
# SENTRY_PROJECT=

# PostHog usage analytics (spec 0019b), EU region. All empty = off (dev, CI, e2e). Production values
# are in specs/0013a-production-deploy.md.
# The project's public ingestion key (api and worker); empty means no event is sent.
# POSTHOG_KEY=
# The ingestion host.
# POSTHOG_HOST=
# The private REST API host, used only by the worker's deletion job.
# POSTHOG_API_HOST=
# A personal API key with scope `person:write` only, for the deletion job; empty means it never runs.
# POSTHOG_PERSONAL_API_KEY=
# The project's numeric id, for the deletion job; empty means it never runs.
# POSTHOG_PROJECT_ID=
# The web's public ingestion key, baked into the build; empty means the browser sends nothing.
# VITE_POSTHOG_KEY=
# The web's ingestion host (empty = https://eu.i.posthog.com).
# VITE_POSTHOG_HOST=

# The admin dashboard (spec 0012b, `make admin`), on http://127.0.0.1:ADMIN_PORT/admin, Gilad only.
# Set your own ADMIN_PASSWORD (the login, 16+ characters) and ADMIN_SECRET_KEY (signs the session
# cookie, 32+): the placeholders below are too short on purpose, so the admin refuses to start until
# real values are set. ADMIN_DB_PASSWORD is the `homie_admin` Postgres role's password
# (scripts/admin_role.py); the dev value is shared with the tests.
ADMIN_PORT=8001
ADMIN_PASSWORD=change-me
ADMIN_SECRET_KEY=change-me
ADMIN_DB_PASSWORD=dev-only-admin-db-password

# The public contact address: the waitlist page's (spec 0017, `make deploy-waitlist`) and the help line of the
# API's security emails (spec 0022a). This placeholder is the API's dev default; `make deploy-waitlist` and an
# https WEB_ORIGIN both refuse it: set the real one on the command line or in `.env` when deploying.
# CONTACT_EMAIL=contact@example.com
# The waitlist's Turnstile site key (spec 0017b, public), read only by `make deploy-waitlist`, which refuses
# a missing key, this placeholder and Cloudflare's test keys. Its secret key is a Pages secret set with
# `make waitlist-secret`, never in `.env`.
# TURNSTILE_SITE_KEY=TURNSTILE_SITE_KEY_PLACEHOLDER
