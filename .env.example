# Copy to `.env` (repo root, gitignored) for local overrides; every `make` target loads it, below the
# shell environment in precedence (README -> Configuration). Plain KEY=value lines: no quotes,
# spaces, `$` or `#` in values. Every variable read by api/app/config.py or interpolated by
# infra/docker-compose.yml is listed here; the values are the defaults the Makefile and compose
# already use, so an unedited copy changes nothing.

# Host ports compose publishes Postgres, Redis and the API on (bound to 127.0.0.1).
DB_PORT=5432
REDIS_PORT=6379
API_PORT=8000

# API settings. If you change DB_PORT / REDIS_PORT, change these URLs to match, or leave them out of
# your `.env`: the Makefile derives them from the ports.
DATABASE_URL=postgresql+psycopg://rent:rent@localhost:5432/rent
TEST_DATABASE_URL=postgresql+psycopg://rent:rent@localhost:5432/rent_test
REDIS_URL=redis://localhost:6379/0
WEB_ORIGIN=http://localhost:5173
