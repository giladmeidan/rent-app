# The admin dashboard (spec 0012b): the same base as Dockerfile.api, with the `admin` group
# (SQLAdmin) instead of the public image's main dependencies only.
# The multi-arch index digest: amd64 on Fly, arm64 on a Mac.
FROM ghcr.io/astral-sh/uv:0.12.16-python3.12-trixie-slim@sha256:4940ff16874f43a0abe9154a3cd7f71b84007d18c175cae3572d683889e51e18

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY api/pyproject.toml api/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-default-groups --group admin

COPY api/ ./

RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin app
USER app

EXPOSE 8001
# IPv6 only: `fly proxy` reaches the machine on its 6PN address. Compose overrides this command.
CMD ["uvicorn", "admin.main:main", "--factory", "--host", "::", "--port", "8001"]
