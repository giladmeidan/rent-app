FROM node:22.23.2-trixie-slim

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

# corepack provides the pnpm version pinned in web/package.json → packageManager.
RUN corepack enable && mkdir /app && chown node:node /app
WORKDIR /app
USER node

# Dependencies first so the layer is cached while application code changes. In compose the source
# tree is bind-mounted over /app and node_modules stays this image's (an anonymous volume).
COPY --chown=node:node web/package.json web/pnpm-lock.yaml ./
RUN --mount=type=cache,target=/home/node/.local/share/pnpm/store,uid=1000,gid=1000 \
    pnpm install --frozen-lockfile

COPY --chown=node:node web/ ./

EXPOSE 5173
CMD ["pnpm", "dev"]
