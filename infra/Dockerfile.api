# The multi-arch index digest: amd64 on Fly, arm64 on a Mac.
FROM ghcr.io/astral-sh/uv:0.12.16-python3.12-trixie-slim@sha256:4940ff16874f43a0abe9154a3cd7f71b84007d18c175cae3572d683889e51e18

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

# glibc keeps a malloc arena per thread; a photo decode (spec 0010d) leaves hundreds of MB in each
# thread's arena, so cap them at two.
ENV MALLOC_ARENA_MAX=2

WORKDIR /app

# Dependencies first so the layer is cached while application code changes. Main dependencies
# only: neither the `dev` nor the `admin` group (spec 0012b).
COPY api/pyproject.toml api/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-default-groups

COPY api/ ./
# The public image cannot import the admin dashboard (spec 0012b NF1); it holds no secrets.
RUN rm -rf admin

# Run unprivileged. The venv in /opt/venv and the code in /app stay root-owned and read-only to
# this user; in compose the source tree is bind-mounted over /app.
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin app
USER app

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-graceful-shutdown", "5"]
